<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="false">

    <display-name>Online Examination and Evaluation System</display-name>

    <listener>
        <listener-class>com.oes.listener.OesServletContextListener</listener-class>
    </listener>

    <!-- Declarative mappings (avoids 404 when container does not scan @WebServlet). -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.oes.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.oes.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.oes.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.oes.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentExamServlet</servlet-name>
        <servlet-class>com.oes.servlet.StudentExamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentExamServlet</servlet-name>
        <url-pattern>/student/exam</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentExamAutosaveServlet</servlet-name>
        <servlet-class>com.oes.servlet.StudentExamAutosaveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentExamAutosaveServlet</servlet-name>
        <url-pattern>/student/exam/autosave</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LegacyExamSubmitRedirectServlet</servlet-name>
        <servlet-class>com.oes.servlet.LegacyExamSubmitRedirectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LegacyExamSubmitRedirectServlet</servlet-name>
        <url-pattern>/student/exam/submit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProctoringEventServlet</servlet-name>
        <servlet-class>com.oes.servlet.ProctoringEventServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProctoringEventServlet</servlet-name>
        <url-pattern>/student/proctor/event</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherExamServlet</servlet-name>
        <servlet-class>com.oes.servlet.TeacherExamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherExamServlet</servlet-name>
        <url-pattern>/teacher/exam/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherExamStatusServlet</servlet-name>
        <servlet-class>com.oes.servlet.TeacherExamStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherExamStatusServlet</servlet-name>
        <url-pattern>/teacher/exam/status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherQuestionServlet</servlet-name>
        <servlet-class>com.oes.servlet.TeacherQuestionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherQuestionServlet</servlet-name>
        <url-pattern>/teacher/exam/questions</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherReportExportServlet</servlet-name>
        <servlet-class>com.oes.servlet.TeacherReportExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherReportExportServlet</servlet-name>
        <url-pattern>/teacher/reports/export</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherBankServlet</servlet-name>
        <servlet-class>com.oes.servlet.TeacherBankServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherBankServlet</servlet-name>
        <url-pattern>/teacher/bank</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherExamRosterServlet</servlet-name>
        <servlet-class>com.oes.servlet.TeacherExamRosterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherExamRosterServlet</servlet-name>
        <url-pattern>/teacher/exam/roster</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherQuestionImportServlet</servlet-name>
        <servlet-class>com.oes.servlet.TeacherQuestionImportServlet</servlet-class>
        <multipart-config>
            <max-file-size>20971520</max-file-size>
            <max-request-size>20971520</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherQuestionImportServlet</servlet-name>
        <url-pattern>/teacher/exam/questions/import</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminManagementServlet</servlet-name>
        <servlet-class>com.oes.servlet.AdminManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminManagementServlet</servlet-name>
        <url-pattern>/admin/manage</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminAnalyticsServlet</servlet-name>
        <servlet-class>com.oes.servlet.AdminAnalyticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAnalyticsServlet</servlet-name>
        <url-pattern>/admin/analytics</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminPanelServlet</servlet-name>
        <servlet-class>com.oes.servlet.AdminPanelServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPanelServlet</servlet-name>
        <url-pattern>/admin/panel</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminExportServlet</servlet-name>
        <servlet-class>com.oes.servlet.AdminExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminExportServlet</servlet-name>
        <url-pattern>/admin/export</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IntegrityDashboardServlet</servlet-name>
        <servlet-class>com.oes.servlet.IntegrityDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IntegrityDashboardServlet</servlet-name>
        <url-pattern>/integrity</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
